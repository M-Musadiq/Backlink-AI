# Environment Variables for Deployment
# Copy to .env and fill in values

# Database (Supabase)
DATABASE_URL=your_supabase_connection_string

# Redis (Upstash)
REDIS_URL=your_upstash_redis_url

# API Keys
GEMINI_API_KEY=your_gemini_api_key
SERPER_API_KEY=your_serper_api_key
TWOCAPTCHA_API_KEY=your_2captcha_api_key
DEVTO_API_KEY=your_devto_api_key

# Vault Encryption Key (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
VAULT_ENCRYPTION_KEY=your_vault_key

# GCP Project (for deployment)
GCP_PROJECT_ID=gaper-internship
